# Django — copy to .env at repo root
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=dev-only-change-me-in-production-use-50-chars-minimum
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalog
# DATABASE_SSL=true

# Staff login for /admin/ (also used by create_store_admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional branding
# STORE_DISPLAY_NAME=Computer Gadget Store
# STORE_USER_LABEL=Barney
# STORE_TIER=pro

# Production only (config.settings.production)
# SECURE_SSL_REDIRECT=true
# LOG_LEVEL=INFO
